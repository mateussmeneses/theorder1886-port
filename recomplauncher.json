{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "The Order: 1886",
  "repo": "mateussmeneses/theorder1886-port",
  "game": {
    "kind": "folder",
    "label": "Your extracted The Order: 1886 PS4 game folder (CUSA00035 v01.02 tested)",
    "check": {
      "file": "eboot.bin"
    }
  },
  "start": {
    "program": [
      "The Order 1886.exe"
    ],
    "args": [
      "--play"
    ]
  },
  "prepare": {
    "program": [
      "The Order 1886.exe"
    ],
    "args": [
      "--recomplauncher-prepare",
      "{game}"
    ],
    "label": "Check the PS4 game folder",
    "timeout": 30
  },
  "config": [
    {
      "id": "launcher",
      "format": "json",
      "file": [
        {
          "path": "{install}/settings.json"
        }
      ],
      "game_path": "game_dir"
    },
    {
      "id": "graphics",
      "format": "ini",
      "file": [
        {
          "path": "{install}/theorder.ini"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "display_mode",
      "label": "Display mode",
      "in": "graphics",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "display_mode": "windowed"
          }
        },
        {
          "label": "Borderless",
          "set": {
            "display_mode": "borderless"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "display_mode": "fullscreen"
          }
        }
      ],
      "defaults": {
        "display_mode": "windowed"
      }
    },
    {
      "id": "output_res",
      "label": "Output resolution",
      "in": "graphics",
      "choices": [
        {
          "label": "720p",
          "set": {
            "output_res": "1280x720"
          }
        },
        {
          "label": "1080p",
          "set": {
            "output_res": "1920x1080"
          }
        },
        {
          "label": "1440p",
          "set": {
            "output_res": "2560x1440"
          }
        },
        {
          "label": "4K",
          "set": {
            "output_res": "3840x2160"
          }
        }
      ],
      "defaults": {
        "output_res": "1920x1080"
      }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "in": "graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "vsync": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "vsync": "1"
          }
        }
      ],
      "defaults": {
        "vsync": "1"
      }
    },
    {
      "id": "fps_limit",
      "label": "Frame rate limit",
      "in": "graphics",
      "choices": [
        {
          "label": "Unlimited",
          "set": {
            "fps_limit": "0"
          }
        },
        {
          "label": "30 fps",
          "set": {
            "fps_limit": "30"
          }
        },
        {
          "label": "60 fps",
          "set": {
            "fps_limit": "60"
          }
        },
        {
          "label": "120 fps",
          "set": {
            "fps_limit": "120"
          }
        },
        {
          "label": "240 fps",
          "set": {
            "fps_limit": "240"
          }
        }
      ],
      "defaults": {
        "fps_limit": "0"
      }
    },
    {
      "id": "show_fps",
      "label": "Performance overlay",
      "in": "graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "show_fps": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "show_fps": "1"
          }
        }
      ],
      "defaults": {
        "show_fps": "1"
      }
    },
    {
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "in": "graphics",
      "choices": [
        {
          "label": "Original (2.40:1, black bars)",
          "set": {
            "aspect_ratio": "original"
          }
        },
        {
          "label": "16:9",
          "set": {
            "aspect_ratio": "16:9"
          }
        },
        {
          "label": "16:10",
          "set": {
            "aspect_ratio": "16:10"
          }
        },
        {
          "label": "21:9",
          "set": {
            "aspect_ratio": "21:9"
          }
        },
        {
          "label": "32:9 (Super Ultrawide)",
          "set": {
            "aspect_ratio": "32:9"
          }
        }
      ],
      "defaults": {
        "aspect_ratio": "original"
      }
    },
    {
      "id": "engine_fps",
      "label": "Game frame rate",
      "in": "graphics",
      "choices": [
        {
          "label": "30 FPS (original)",
          "set": {
            "engine_fps": "60"
          }
        },
        {
          "label": "60 FPS (default)",
          "set": {
            "engine_fps": "120"
          }
        },
        {
          "label": "120 FPS (unlocked)",
          "set": {
            "engine_fps": "240"
          }
        }
      ],
      "defaults": {
        "engine_fps": "120"
      }
    },
    {
      "id": "anisotropy",
      "label": "Anisotropic filtering",
      "in": "graphics",
      "choices": [
        {
          "label": "Game default",
          "set": {
            "anisotropy": "0"
          }
        },
        {
          "label": "2x",
          "set": {
            "anisotropy": "2"
          }
        },
        {
          "label": "4x",
          "set": {
            "anisotropy": "4"
          }
        },
        {
          "label": "8x",
          "set": {
            "anisotropy": "8"
          }
        },
        {
          "label": "16x",
          "set": {
            "anisotropy": "16"
          }
        }
      ],
      "defaults": {
        "anisotropy": "0"
      }
    },
    {
      "id": "master_volume",
      "label": "Master volume",
      "in": "graphics",
      "choices": [
        {
          "label": "0%",
          "set": {
            "master_volume": "0"
          }
        },
        {
          "label": "25%",
          "set": {
            "master_volume": "25"
          }
        },
        {
          "label": "50%",
          "set": {
            "master_volume": "50"
          }
        },
        {
          "label": "75%",
          "set": {
            "master_volume": "75"
          }
        },
        {
          "label": "100%",
          "set": {
            "master_volume": "100"
          }
        },
        {
          "label": "125%",
          "set": {
            "master_volume": "125"
          }
        },
        {
          "label": "150%",
          "set": {
            "master_volume": "150"
          }
        },
        {
          "label": "175%",
          "set": {
            "master_volume": "175"
          }
        },
        {
          "label": "200%",
          "set": {
            "master_volume": "200"
          }
        }
      ],
      "defaults": {
        "master_volume": "100"
      }
    },
    {
      "id": "audio_channels",
      "label": "Speakers",
      "in": "graphics",
      "choices": [
        {
          "label": "Automatic (the device's)",
          "set": {
            "audio_channels": "auto"
          }
        },
        {
          "label": "Stereo",
          "set": {
            "audio_channels": "stereo"
          }
        },
        {
          "label": "5.1",
          "set": {
            "audio_channels": "5.1"
          }
        },
        {
          "label": "7.1",
          "set": {
            "audio_channels": "7.1"
          }
        }
      ],
      "defaults": {
        "audio_channels": "auto"
      }
    },
    {
      "id": "pause_game",
      "label": "Pause while the menu is open",
      "in": "graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "pause_game": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "pause_game": "1"
          }
        }
      ],
      "defaults": {
        "pause_game": "1"
      }
    }
  ],
  "saves": [
    "{install}/user/savedata"
  ]
}
